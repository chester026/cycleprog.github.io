{
  "name": "@bikelab/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, pure calculations, constants and API contract pieces used by server, react-spa and BikeLabApp.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs",
      "types": "./dist/*.d.ts"
    }
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.5",
    "vitest": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1"
  }
}
