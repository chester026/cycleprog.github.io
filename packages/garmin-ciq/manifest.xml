<?xml version="1.0"?>
<!-- Garmin Connect IQ device app for Edge (docs/plans/garmin-connect-iq.md).
     type="watch-app" is Connect IQ's name for a device app on every product
     family, Edge included. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
  <iq:application id="d8e4b4b7b35a47b58a9d8378c9446ec0" type="watch-app" name="@Strings.AppName" entry="BikeLabApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="4.2.0">
    <iq:products>
      <iq:product id="edge1040"/>
      <iq:product id="edge1050"/>
    </iq:products>
    <iq:permissions>
      <iq:uses-permission id="Communications"/>
    </iq:permissions>
    <iq:languages>
      <iq:language>eng</iq:language>
      <iq:language>rus</iq:language>
    </iq:languages>
    <iq:barrels/>
  </iq:application>
</iq:manifest>
