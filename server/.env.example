# Copy to .env and fill in real values. server.js refuses to start
# (config/index.js, zod-validated) if STRAVA_CLIENT_ID, STRAVA_CLIENT_SECRET,
# JWT_SECRET, OPENAI_API_KEY, or a Postgres target (PGHOST or DATABASE_URL)
# are missing or malformed.

# --- Server ---
PORT=                       # HTTP port (default 8080)
NODE_ENV=                   # "production" enables secure cookies/SSL defaults and hides error details
FRONTEND_URL=                # Base URL of the web app, e.g. https://bikelab.app — used to build email links, CORS allowlist and OAuth redirect URIs
BACKEND_BASE=                 # Base URL Strava redirects back to (this server's /exchange_token, /link_strava). Falls back to FRONTEND_URL, then https://bikelab.app — only needs setting if the API is deployed on a different host than the web app.
LEGACY_MOBILE_COMPAT=        # "true" keeps the App Store build of BikeLabApp working (state-less ?mobile=true Strava login via /auth/success, non-admin POST /api/skills-history + /api/analytics-snapshot answer 200). Default false. Remove once the refactored build is in the store.
MIGRATE_ON_START=            # "false" disables running `npm run migrate` automatically before app.listen (default true) — set false when migrations run as a separate deploy step ahead of starting the server
LOG_LEVEL=                   # pino log level (trace/debug/info/warn/error/fatal). Defaults to "debug" in development, "info" otherwise.

# --- Sentry (optional error/perf monitoring) ---
SENTRY_DSN=                  # When unset, Sentry is never initialized and all Sentry calls are no-ops
SENTRY_ENV=                  # Defaults to NODE_ENV

# --- Auth ---
JWT_SECRET=                  # Secret used to sign/verify session JWTs. Required, >=32 chars in production (NODE_ENV=production), >=8 chars otherwise (config/index.js warns if <32 outside production).

# --- Postgres (used by server.js/db.js) ---
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=                   # set to "require" to force SSL (Render-style managed Postgres)
PGSSLROOTCERT=               # optional path to a CA bundle file; when set, Postgres TLS is verified against it instead of ssl.rejectUnauthorized=false
DATABASE_URL=                # alternative to the PG* vars above; either PGHOST or DATABASE_URL must be set

# --- Strava OAuth (required) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- OpenAI (required — coach chat, AI analysis, AI goal generation) ---
OPENAI_API_KEY=
COACH_MODEL=                 # OpenAI model for the AI coach chat (default: gpt-4.1-mini)
OPENAI_GOALS_MODEL=          # model for AI goal generation (default: gpt-4o-mini; no multi-model fallback any more)
# Cost control (T-4.4) — all optional, defaults shown
COACH_HISTORY_MESSAGES=30           # history messages loaded from coach_messages per chat turn
COACH_HISTORY_MAX_CHARS=24000       # rough token budget for that history (oldest dropped first)
COACH_CHAT_MAX_TOKENS=1200
COACH_SUGGESTIONS_MAX_TOKENS=300
AI_DAILY_TOKEN_BUDGET=2000000       # per-user tokens/day across coach, ai-analysis, ai-generate → 429 AI_BUDGET_EXCEEDED (cached prompt tokens billed at 25% weight); admins are exempt

# --- Auth (T-4.5) — optional, defaults shown ---
ACCESS_TOKEN_TTL=7d          # session JWT lifetime; drops to 1h once clients use refresh tokens (phases 5/6)
REFRESH_TOKEN_TTL_DAYS=60

# --- Cache / multi-instance (T-4.3) — optional ---
REDIS_URL=                   # e.g. redis://:password@host:6379 — when set: activities/bikes/weather/AI caches, Strava quota view and rate-limit store live in Redis (shared across instances). Unset = in-memory, single instance.

# --- Brevo (transactional email: verification, password reset) ---
BREVO_API_KEY=

# --- ImageKit (garage/hero image storage) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Oura (optional health-data integration) ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# --- Standalone maintenance scripts (apply_profile.js / optimize_postgres.js) ---
# Not read by server.js itself — only by these one-off DB tuning scripts.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=
